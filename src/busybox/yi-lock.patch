+/* Kernel-owned abstract socket; descriptor remains private to ash. */
+static int FAST_FUNC yi_lockcmd(int argc, char **argv)
+{
+    struct sockaddr_un addr;
+    struct yi_lock_fd *lock, **link;
+    const char *name;
+    int fd, copy, err, release = argc == 3 && strcmp(argv[1], "-u") == 0;
+    size_t len;
+    if ((!release && argc != 2) || (release && argc != 3)) return 2;
+    name = argv[release ? 2 : 1];
+    len = strlen(name);
+    if (!len || len >= sizeof(lock->name) || strspn(name, "abcdefghijklmnopqrstuvwxyz0123456789-.") != len)
+        return 2;
+    INT_OFF;
+    for (link = &yi_locks; (lock = *link) != NULL; link = &lock->next) {
+        if (strcmp(lock->name, name) == 0) {
+            if (!release) { INT_ON; return 75; }
+            *link = lock->next;
+            close(lock->fd);
+            free(lock);
+            INT_ON;
+            return 0;
+        }
+    }
+    if (release) { INT_ON; return 2; }
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    memcpy(addr.sun_path + 1, "yi-hack.v1.", 11);
+    memcpy(addr.sun_path + 12, name, len);
+    fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    if (fd < 0) goto error;
+    copy = fcntl(fd, F_DUPFD, 10);
+    err = errno;
+    close(fd);
+    errno = err;
+    fd = copy;
+    if (fd < 0) goto error;
+    if (fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) goto close_error;
+    if (bind(fd, (struct sockaddr *)&addr,
+             offsetof(struct sockaddr_un, sun_path) + 12 + len) < 0) {
+        err = errno;
+        close(fd);
+        if (err == EADDRINUSE) { INT_ON; return 75; }
+        errno = err;
+        goto error;
+    }
+    lock = xzalloc(sizeof(*lock));
+    lock->fd = fd;
+    strcpy(lock->name, name);
+    lock->next = yi_locks;
+    yi_locks = lock;
+    INT_ON;
+    return 0;
+ close_error:
+    err = errno;
+    close(fd);
+    errno = err;
+ error:
+    bb_perror_msg("yi_lock %s", name);
+    INT_ON;
+    return 1;
+}
+
