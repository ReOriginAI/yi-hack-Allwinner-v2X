
set -e

LIBMAIN_PATH=/opt/yi/toolchain-sunxi-musl/toolchain

qemu-arm-static -L $LIBMAIN_PATH -E LD_LIBRARY_PATH=./_install/lib/ ./_install/yi-hack/bin/busybox --help 

# Missing ash/timeout or an unapplied lock patch must fail the firmware build.
qemu-arm-static -L "$LIBMAIN_PATH" -E LD_LIBRARY_PATH=./_install/lib/ ./_install/yi-hack/bin/busybox ash -c 'yi_lock build-probe && yi_lock -u build-probe'
qemu-arm-static -L "$LIBMAIN_PATH" -E LD_LIBRARY_PATH=./_install/lib/ ./_install/yi-hack/bin/busybox timeout -s KILL 1 /bin/true
