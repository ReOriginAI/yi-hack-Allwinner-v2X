#!/bin/sh
# rmm yi_sync_time expects code 20000 and Unix time in milliseconds.
# NTP belongs to yi-hack's configured time service, never this compatibility API.
while [ "$#" -gt 0 ]; do
    if [ "$1" = -c ]; then
        shift
        [ "$#" -gt 0 ] || exit 1
        command_id=$1
    fi
    shift
done
case "$command_id" in
    136) printf '{"code":"20000","time":%s000}\n' "$(date +%s)" ;;
    *) exit 1 ;;
esac
