CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL_TINY=y
CONFIG_TLS=none
CONFIG_INTERNAL_AES=y
CONFIG_INTERNAL_SHA1=y
CONFIG_INTERNAL_MD5=y
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_CTRL_IFACE=y
CONFIG_NO_TKIP=y
CONFIG_NO_STDOUT_DEBUG=y
CFLAGS += -Os -mthumb -flto -D_GNU_SOURCE -DCONFIG_CRYPTO_INTERNAL -ffunction-sections -fdata-sections
LDFLAGS += -flto -Wl,--gc-sections
LIBS += -lm
